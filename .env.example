# Local environment template. Copy to `.env` for docker compose, or export the
# values in your shell. Every value below is optional: the code falls back to
# repository-relative defaults.

# Application
ENVIRONMENT=development
LOG_LEVEL=info

# Backend
API_PORT=8000
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Model overrides. Paths are resolved from the repository root when unset.
AMAZON_MODEL_DIR=artifacts/models/word2vec_bilstm
# AMAZON_VOCAB_PATH=artifacts/models/word2vec_bilstm/vocab.json
GOEMOTIONS_MODEL_DIR=artifacts/models/distilbert_goemotions
MODEL_DEVICE=cpu

# The frontend reads NEXT_PUBLIC_API_URL from frontend/.env.local, not from this
# file. See frontend/.env.example.
